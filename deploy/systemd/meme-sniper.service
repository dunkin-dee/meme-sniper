[Unit]
Description=meme-sniper pump.fun launch recorder
Documentation=file:///opt/meme-sniper/docs/DEPLOY.md
After=network-online.target
Wants=network-online.target

# Rate-limit directives live in [Unit], NOT [Service]. systemd silently ignored
# these when they sat in [Service] ("Unknown key name ... ignoring", observed
# 2026-08-05), which left the default 5-starts-in-10s limit in force - exactly
# the case where a network flap could exhaust the burst and leave the recorder
# stopped overnight. Every gap is launches that can never be backfilled.
StartLimitIntervalSec=0
StartLimitBurst=0

[Service]
Type=simple
User=sniper
Group=sniper
WorkingDirectory=/opt/meme-sniper
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/meme-sniper/env
ExecStart=/opt/meme-sniper/.venv/bin/python -m sniper.main record

# The recorder already reconnects internally with backoff. This is the outer
# net for process death (OOM, unhandled fault, host reboot). Every gap here is
# launches that can never be backfilled, so restart is unconditional.
Restart=always
RestartSec=10s

# The recorder shuts down cleanly on SIGINT (flushes and closes SQLite).
KillSignal=SIGINT
TimeoutStopSec=30

# Hardening. The process needs outbound network and its own data dir, nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/meme-sniper/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=meme-sniper

[Install]
WantedBy=multi-user.target
